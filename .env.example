# Zero-Contest Streak Bot Configuration
# PLATFORM options: leetcode, codechef, codeforces, hackerrank
PLATFORM=leetcode
LANGUAGE=python
DIFFICULTY=Easy
DAILY_PROBLEM_COUNT=1
HEADLESS=false
MAX_RETRIES=3
LOG_LEVEL=INFO

# Platform Session Cookie Configuration
# 1. LeetCode Session Cookies
LEETCODE_SESSION=
CSRFTOKEN=

# 2. CodeChef Session Cookie (authtoken)
CODECHEF_SESSION=

# 3. Codeforces Session Cookie (JSESSIONID)
CODEFORCES_SESSION=

# 4. HackerRank Session Cookie (_hr_session)
HACKERRANK_SESSION=
